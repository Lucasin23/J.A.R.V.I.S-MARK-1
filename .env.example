# Create a private .env file beside main.py and add your real key there.
GEMINI_API_KEY=replace-with-your-key

# Keep this configurable: availability can differ between Gemini API tiers.
GEMINI_MODEL=gemini-3.7-flash
JARVIS_WAKE_WORD=jarvis

# Optional macOS voice settings. Leave empty to use the system default.
JARVIS_VOICE=
JARVIS_SPEECH_RATE=185
